# EditorConfig keeps everyone's editor on the same settings, whatever
# editor they use. VS Code needs the "EditorConfig" extension for this.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces mean a line break in Markdown, keep them.
trim_trailing_whitespace = false
